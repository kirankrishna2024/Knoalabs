# ======================= Admin panel (/admin) =======================
# First admin login. Created on start if that ID does not exist yet (change it later with: npm run admin:set -- <id>).
# ID: 3-40 letters/digits/._-   Password: at least 10 characters. Remove ADMIN_PASSWORD from the env once the user exists.
# NOTE: do not put # or the value after it in the password: dotenv truncates the line at the first #.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin!secret993329
# Signs the login cookie. At least 32 characters, keep it secret, required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=devsessionsecret1234567890123456789012345
# How long a login lasts (hours), and login attempts allowed per IP per 10 minutes
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_MAX=10

# ======================= Location (ipapi.co, optional) =======================
# Approximate city / region / country of each new lead, looked up after the registration is saved (never delays it).
# GEO_PROVIDER=ipapi uses https://ipapi.co/{ip}/json/ and keeps the fields src/geo.js normalises.
# GEO_IP_SALT is required in production when the provider is on: IP addresses are stored only as salted hashes.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GEO_PROVIDER=ipapi
GEO_IP_SALT=change-me-min-16-charsvewrgrgere432vsa
GEO_DAILY_LIMIT=900
GEO_STORE_POSTAL=false
GEO_VISITORS=true
# Also look up visitors (link opens), not only registrations. Uses the same daily limit.
GEO_VISITORS=false
