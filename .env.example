# ======================= Server =======================
NODE_ENV=production
PORT=8080
# 1 when behind ONE proxy/load balancer (DigitalOcean App Platform, Cloudflare, Nginx). Needed so the
# rate limiter sees the real visitor IP and the login cookie gets the Secure flag. 0 if exposed directly.
TRUST_PROXY=1
# fatal | error | warn | info | debug | silent  (logs are JSON, one line each, no personal data)
LOG_LEVEL=info
APP_NAME=knoalabs-landing
# Time zone for "Today", the date filters and the times in the Excel file (IANA name)
TIMEZONE=Asia/Kolkata

# ======================= Database (PostgreSQL) =======================
# DigitalOcean managed PostgreSQL: use the DIRECT port (25060), not the connection pool (25061).
# Paste the URL from the DO dashboard as is; TLS is turned on automatically for *.db.ondigitalocean.com.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/DBNAME?sslmode=require
# Leave empty to auto-detect. true = force TLS, false = force off (local Postgres only).
DATABASE_SSL=
# Optional but recommended: the cluster CA certificate (DO dashboard > Connection details > Download CA). Newlines as \\n.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
AUTO_MIGRATE=true

# ======================= Admin panel  (/admin) =======================
# First admin login. Created on start if that ID does not exist yet (change it later with: npm run admin:set -- <id>).
# ID: 3-40 letters/digits/._-   Password: at least 10 characters. Remove ADMIN_PASSWORD from the env once the user exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs the login cookie. At least 32 characters, keep it secret, required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# How long a login lasts (hours), and login attempts allowed per IP per 10 minutes
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_MAX=10

# ======================= Misc =======================
# Max registrations per IP per 10 minutes
RATE_LIMIT_MAX=10
